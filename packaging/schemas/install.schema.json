{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "applicationVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[a-z]+\\.\\d+)?$"
    },
    "sourceRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "os": {
      "enum": [
        "linux",
        "darwin"
      ]
    },
    "arch": {
      "enum": [
        "x64",
        "arm64"
      ]
    },
    "abiFloor": {
      "type": "string",
      "minLength": 1
    },
    "runtime": {
      "enum": [
        "native-linux",
        "control-only"
      ]
    },
    "executables": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "version": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "version",
            "sha256"
          ]
        },
        "gitstored": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "version": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "version",
            "sha256"
          ]
        }
      },
      "required": [
        "gs",
        "gitstored"
      ]
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(bin/(gs|gitstored)|lib/[^/]+|share/.+)$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "mode": {
            "enum": [
              420,
              493
            ]
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes",
          "mode"
        ]
      },
      "minItems": 1
    },
    "libraryClosure": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "delivery": {
            "enum": [
              "private",
              "static",
              "system"
            ]
          }
        },
        "required": [
          "name",
          "sha256",
          "license",
          "source",
          "delivery"
        ]
      }
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "reference": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "completions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  },
  "required": [
    "schemaVersion",
    "applicationVersion",
    "sourceRevision",
    "os",
    "arch",
    "abiFloor",
    "runtime",
    "executables",
    "files",
    "libraryClosure",
    "notices",
    "reference",
    "completions"
  ]
}
