{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "reviewDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "upstreamRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "upstreamTag": {
      "type": "string",
      "minLength": 1
    },
    "evidenceLevel": {
      "const": "source-only"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "gitBlob": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        },
        "required": [
          "path",
          "gitBlob"
        ]
      },
      "minItems": 1
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CMD-\\d{3}$"
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "milestone": {
            "enum": [
              "M1",
              "M2",
              "M3"
            ]
          },
          "classification": {
            "enum": [
              "implemented",
              "client-work",
              "validation-work",
              "external-contract",
              "deferred"
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "clientPath": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "source-reviewed",
              "pass",
              "fail",
              "not-run"
            ]
          },
          "gate": {
            "type": "string",
            "minLength": 1
          },
          "tests": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "overlays": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "operation": {
                  "type": "string",
                  "minLength": 1
                },
                "classification": {
                  "enum": [
                    "implemented",
                    "client-work",
                    "validation-work",
                    "external-contract",
                    "deferred"
                  ]
                },
                "gate": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "operation",
                "classification",
                "gate"
              ]
            }
          }
        },
        "required": [
          "id",
          "command",
          "milestone",
          "classification",
          "sources",
          "clientPath",
          "result",
          "gate",
          "tests",
          "overlays"
        ]
      },
      "minItems": 84,
      "maxItems": 84
    }
  },
  "required": [
    "schemaVersion",
    "reviewDate",
    "upstreamRevision",
    "upstreamTag",
    "evidenceLevel",
    "sources",
    "commands"
  ]
}
