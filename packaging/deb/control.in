Package: gitstore
Version: @VERSION@
Architecture: @ARCH@
Maintainer: GitStore contributors
Section: devel
Priority: optional
Depends: libc6 (>= 2.39), libgcc-s1, ca-certificates, systemd (>= 255), dbus-user-session
