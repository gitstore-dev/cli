option(GITSTORED_BOOTSTRAP "Link core bootstrap hashing/HTTP code libraries (Linux development)" OFF)
if(GITSTORED_BOOTSTRAP)
  if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
    message(FATAL_ERROR "Initial native core bootstrap requires Linux")
  endif()
  set(bootstrap_queries "")
  foreach(query_name login enroll)
    set(query_path "${CMAKE_CURRENT_SOURCE_DIR}/../runtime/profiles/bootstrap-${query_name}.graphql")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${query_path}")
    file(READ "${query_path}" query_hex HEX)
    string(REGEX REPLACE "(..)" "0x\\1,\n" query_bytes "${query_hex}")
    string(APPEND bootstrap_queries "static const char bootstrap_${query_name}_query[] = {${query_bytes}0};\n")
  endforeach()
  file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/bootstrap_queries.inc" CONTENT "${bootstrap_queries}")
  find_package(PkgConfig REQUIRED)
  pkg_check_modules(GITSTORED_BOOTSTRAP_LIBS REQUIRED IMPORTED_TARGET libxcrypt>=4.4.36 libcurl>=8.5.0)
  target_compile_definitions(gitstored_core PRIVATE GITSTORED_BOOTSTRAP=1)
  target_link_libraries(gitstored_core PRIVATE PkgConfig::GITSTORED_BOOTSTRAP_LIBS)
  if(GITSTORED_TESTING)
    add_executable(test_bootstrap_job tests/test_bootstrap_job.c)
    target_include_directories(test_bootstrap_job PRIVATE src tests)
    target_link_libraries(test_bootstrap_job PRIVATE gitstored_core gitstored_test_support gitstored_options)
    add_test(NAME private_bootstrap_worker_boundary COMMAND test_bootstrap_job)
    if(GITSTORED_LIBCRUN AND GITSTORED_SLIRP)
      add_executable(core_bootstrap_probe tests/core_bootstrap_probe.c)
      target_include_directories(core_bootstrap_probe PRIVATE src)
      target_link_libraries(core_bootstrap_probe PRIVATE gitstored_core gitstored_options)
    endif()
    add_executable(bootstrap_http_probe tests/bootstrap_http_probe.c)
    target_include_directories(bootstrap_http_probe PRIVATE src)
    target_link_libraries(bootstrap_http_probe PRIVATE gitstored_core gitstored_options)
    add_executable(oidc_http_probe tests/oidc_http_probe.c)
    target_include_directories(oidc_http_probe PRIVATE src)
    target_link_libraries(oidc_http_probe PRIVATE gitstored_core gitstored_options)
    add_executable(bootstrap_provision_probe tests/bootstrap_provision_probe.c)
    target_include_directories(bootstrap_provision_probe PRIVATE src)
    target_link_libraries(bootstrap_provision_probe PRIVATE gitstored_core gitstored_options)
    add_executable(test_bootstrap_files tests/test_bootstrap_files.c)
    target_include_directories(test_bootstrap_files PRIVATE src tests)
    target_link_libraries(test_bootstrap_files PRIVATE gitstored_core gitstored_test_support gitstored_options)
    add_test(NAME private_bootstrap_files COMMAND test_bootstrap_files)
    add_executable(test_oidc_material tests/test_oidc_material.c)
    target_include_directories(test_oidc_material PRIVATE src)
    target_link_libraries(test_oidc_material PRIVATE gitstored_core gitstored_options)
    add_test(NAME private_oidc_material COMMAND test_oidc_material)
    if(GITSTORED_LIBCRUN)
      add_executable(oidc_preparation_probe tests/oidc_preparation_probe.c tests/oidc_async_probe.c)
      target_include_directories(oidc_preparation_probe PRIVATE src)
      target_link_libraries(oidc_preparation_probe PRIVATE gitstored_core gitstored_options)
      add_executable(oidc_deployment_probe tests/oidc_deployment_probe.c)
      target_include_directories(oidc_deployment_probe PRIVATE src)
      target_link_libraries(oidc_deployment_probe PRIVATE gitstored_core gitstored_options)
      add_executable(oidc_setup_probe tests/oidc_setup_probe.c tests/oidc_migration_journal_probe.c)
      target_include_directories(oidc_setup_probe PRIVATE src)
      target_link_libraries(oidc_setup_probe PRIVATE gitstored_core gitstored_options)
      add_library(oidc_probe_support STATIC tests/oidc_probe_support.c)
      target_include_directories(oidc_probe_support PRIVATE src tests "${CMAKE_CURRENT_BINARY_DIR}")
      target_link_libraries(oidc_probe_support PRIVATE gitstored_core gitstored_options)
      add_executable(oidc_graph_probe tests/oidc_graph_probe.c)
      target_include_directories(oidc_graph_probe PRIVATE src tests "${CMAKE_CURRENT_BINARY_DIR}")
      target_link_libraries(oidc_graph_probe PRIVATE oidc_probe_support gitstored_core gitstored_options)
      add_executable(oidc_serve_probe "${CMAKE_CURRENT_SOURCE_DIR}/tests/oidc_serve_probe.c")
      target_include_directories(oidc_serve_probe PRIVATE src "${CMAKE_CURRENT_BINARY_DIR}")
      target_link_libraries(oidc_serve_probe PRIVATE oidc_probe_support gitstored_core gitstored_options)
    endif()
    add_executable(test_bootstrap_material tests/test_bootstrap_material.c)
    target_include_directories(test_bootstrap_material PRIVATE src)
    target_link_libraries(test_bootstrap_material PRIVATE gitstored_core gitstored_options)
    add_test(NAME private_bootstrap_material COMMAND test_bootstrap_material)
  endif()
endif()
