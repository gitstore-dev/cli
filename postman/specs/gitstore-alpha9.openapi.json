{
  "openapi": "3.1.0",
  "info": {
    "title": "GitStore alpha.9 File ID and namespace/name lookup consumer",
    "version": "0.1.0-alpha.9",
    "description": "Consumer GraphQL envelope at GitStore commit 68f8471edc947e417c98b6e8299a1367ab6b20da. The File operation accepts exactly one ID or namespacePath selector. CLI core resource reads use schema-verified metadata/spec/status/body projections from shared/schemas/admin; structured JSON/YAML retain these fields, bounded lists retain pageInfo without a global snapshot promise. Writes, subscriptions and other operations are outside this operation contract. Owned disposable fixtures only."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:4000"
    }
  ],
  "paths": {
    "/admin/graphql": {
      "post": {
        "operationId": "readAlpha9File",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "query",
                  "variables"
                ],
                "properties": {
                  "query": {
                    "type": "string"
                  },
                  "variables": {
                    "type": "object",
                    "required": ["by"],
                    "properties": {
                      "by": {
                        "oneOf": [
                          {"type": "object", "required": ["id"], "additionalProperties": false,
                           "properties": {"id": {"type": "string", "minLength": 1}}},
                          {"type": "object", "required": ["namespacePath"], "additionalProperties": false,
                           "properties": {"namespacePath": {"type": "object", "required": ["namespace", "name"], "additionalProperties": false,
                             "properties": {"namespace": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}}}}}
                        ]
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "example": {
                "query": "query Read($by:FileBy!){file(by:$by){id apiVersion kind metadata{name namespace uid resourceVersion generation revision} body spec{contentType}}}",
                "variables": {
                  "by": {
                    "namespacePath": {
                      "namespace": "shop",
                      "name": "fixture"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "GraphQL result; a missing File is data.file null. GraphQL errors are distinct from transport success.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": [
                        "object",
                        "null"
                      ]
                    },
                    "errors": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
